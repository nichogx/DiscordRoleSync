<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs findings to ignore. See https://spotbugs.readthedocs.io/en/latest/filter.html -->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- Not applicable to this plugin -->

    <!-- Sharing references to the plugin, config, JDA objects etc. between classes is intended -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- The table name comes from database.tablePrefix in the admin's config. All user input uses parameters -->
    <Match>
        <Class name="dev.nicho.rolesync.db.DatabaseHandler"/>
        <Bug pattern="SQL_INJECTION_JDBC"/>
    </Match>

    <!-- File paths come from the plugin's data folder and the admin's config -->
    <Match>
        <Class name="dev.nicho.rolesync.RoleSync"/>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>

    <!-- The username from /link is appended to the URL path, but can't change the host the request goes to -->
    <Match>
        <Or>
            <Class name="dev.nicho.rolesync.minecraft.MojangAPI"/>
            <Class name="dev.nicho.rolesync.minecraft.XboxAPI"/>
        </Or>
        <Bug pattern="URLCONNECTION_SSRF_FD"/>
    </Match>

    <!-- Existing issues, ignored so new ones fail CI. Remove each entry when it's fixed -->

    <!-- Connections, statements and result sets are not closed if a query throws -->
    <Match>
        <Class name="dev.nicho.rolesync.db.DatabaseHandler"/>
        <Bug pattern="OBL_UNSATISFIED_OBLIGATION,ODR_OPEN_DATABASE_RESOURCE"/>
    </Match>

    <!-- Files are read with the platform's default charset instead of UTF-8 -->
    <Match>
        <Or>
            <Class name="dev.nicho.rolesync.RoleSync"/>
            <Class name="dev.nicho.rolesync.config.ConfigReader"/>
        </Or>
        <Bug pattern="DM_DEFAULT_ENCODING"/>
    </Match>

    <!-- Catches Exception where only IOException is declared -->
    <Match>
        <Class name="dev.nicho.rolesync.RoleSync"/>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>

    <!-- getMember() is null for uncached members, so they are not removed from the whitelist -->
    <Match>
        <Class name="dev.nicho.rolesync.bot.listeners.MemberEventsListener"/>
        <Bug pattern="DCN_NULLPOINTER_EXCEPTION"/>
    </Match>

    <!-- Uses \n instead of %n in String.format, and keySet() + get() instead of entrySet() -->
    <Match>
        <Class name="dev.nicho.rolesync.config.linter.LintResult"/>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE,WMI_WRONG_MAP_ITERATOR"/>
    </Match>
</FindBugsFilter>
